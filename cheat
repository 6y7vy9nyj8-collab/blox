    if not fruitData then return end

    -- Process and use the fetched data
    processAndUseFruitData(fruitData)
end

function processAndUseFruitData(fruitData)
    -- Implement your logic here, such as modifying game state or displaying information
    print("Blox Fruit Data: " .. tostring(fruitData))
end

-- HTTP Request Function
function performHTTPRequest(url)
    -- Perform a simple GET request to the specified URL
    local result, status, header = https.request{
        url = url,
        method = "GET",
    }

    if status then return result elseif not status then return nil else error(tostring(status)) end
end

-- Inventory Management Functions
function addBloxFruitToFInventory(fruitName)
    -- Add a specified Blox Fruit item to the in-game inventory
    local inventoryItems = getInventoryItems()
    table.insert(inventoryItems, fruitName)
    saveInventoryState(inventoryItems)
end

function removeBloxFruitFromInventory(fruitName)
    -- Remove a specified Blox Fruit item from the in-game inventory
    local inventoryItems = getInventoryState()
    for i, item in ipairs(inventoryItems) do
        if item == fruitName then
            table.remove(inventoryItems, i)
            saveInventoryState(inventoryItems)
            print("Removed " .. fruitName .. " from inventory.")
            return true
        end
    end
    print(fruitName .. " not found in the inventory.")
end

